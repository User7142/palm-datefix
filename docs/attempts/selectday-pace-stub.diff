+    FtrGet(appCreator, ftrStubBytes + 1, &saved[1]);
+    PatchStub((UInt8 *)stub, (UInt8 *)saved);
+    FtrUnregister(appCreator, ftrStubAddress);
+    FtrUnregister(appCreator, ftrStubBytes);
+    FtrUnregister(appCreator, ftrStubBytes + 1);
+  }
+  else if (FtrGet(appCreator, ftrOrigSelectDay, &orig) == errNone)
+  {
+    SysSetTrapAddress(sysTrapSelectDay, (void *)orig);
